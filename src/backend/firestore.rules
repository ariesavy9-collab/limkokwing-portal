rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staff() {
      return signedIn()
        && request.auth.token.admin == true
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email));
    }

    function validName(name, maximumLength) {
      return name is string
        && name.size() >= 2
        && name.size() <= maximumLength
        && name.matches("^[A-Za-zÀ-ÖØ-öø-ÿ'’.-]+( [A-Za-zÀ-ÖØ-öø-ÿ'’.-]+)*$");
    }

    function validText(value, minimumLength, maximumLength) {
      return value is string
        && value.size() >= minimumLength
        && value.size() <= maximumLength
        && !value.matches('^\\s*$');
    }

    function registeredStudent() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email))
        && get(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email)).data.studentId.matches('^90[0-9]{7}$');
    }

    match /adminUsers/{email} {
      allow read: if staff() || (signedIn() && request.auth.token.email == email);
      allow write: if staff();
    }

    match /studentDirectory/{email} {
      allow read: if staff() || (signedIn() && request.auth.token.email == email);
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['name', 'email', 'studentId', 'dateOfBirth', 'birthPlace', 'phone', 'address', 'faculty', 'course', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'studentId', 'dateOfBirth', 'birthPlace', 'phone', 'address', 'faculty', 'course', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.name, 20)
        && request.resource.data.email == email
        && request.resource.data.studentId.matches('^90[0-9]{7}$')
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validText(request.resource.data.birthPlace, 2, 100)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+?[0-9]{8,15}$')
        && validText(request.resource.data.address, 5, 240)
        && validText(request.resource.data.faculty, 2, 120)
        && validText(request.resource.data.course, 2, 120);
      allow update: if staff()
        && request.resource.data.keys().hasOnly(['name', 'email', 'studentId', 'dateOfBirth', 'birthPlace', 'phone', 'address', 'faculty', 'course', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'studentId', 'dateOfBirth', 'birthPlace', 'phone', 'address', 'createdAt', 'updatedAt'])
        && validName(request.resource.data.name, 20)
        && request.resource.data.email == email
        && request.resource.data.studentId.matches('^90[0-9]{7}$')
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && validText(request.resource.data.birthPlace, 2, 100)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+?[0-9]{8,15}$')
        && validText(request.resource.data.address, 5, 240)
        && (!request.resource.data.keys().hasAny(['faculty']) || validText(request.resource.data.faculty, 2, 120))
        && (!request.resource.data.keys().hasAny(['course']) || validText(request.resource.data.course, 2, 120));
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'studentId', 'dateOfBirth', 'birthPlace', 'address', 'createdAt', 'updatedAt'
        ])
        && validName(request.resource.data.name, 20)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.studentId is string
        && (staff() || (registeredStudent()
          && request.resource.data.name == get(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email)).data.name
          && request.resource.data.studentId == get(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email)).data.studentId
          && (!request.resource.data.keys().hasAny(['dateOfBirth'])
            || request.resource.data.dateOfBirth == get(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email)).data.dateOfBirth)
          && (!request.resource.data.keys().hasAny(['birthPlace'])
            || request.resource.data.birthPlace == get(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email)).data.birthPlace)))
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 240
        && (request.resource.data.phone == ''
          || request.resource.data.phone.matches('^\\+?[0-9]{8,15}$'));
      allow update: if false;
      allow delete: if false;
    }

    match /studentLetters/{letterId} {
      allow read: if staff()
        || (signedIn() && request.auth.token.email == resource.data.studentEmail);
      allow create: if staff()
        && request.resource.data.keys().hasOnly([
          'studentEmail', 'studentName', 'studentId', 'title', 'body',
          'createdBy', 'status', 'createdAt'
        ])
        && request.resource.data.studentEmail is string
        && request.resource.data.studentEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && exists(/databases/$(database)/documents/studentDirectory/$(request.resource.data.studentEmail))
        && request.resource.data.studentId == get(/databases/$(database)/documents/studentDirectory/$(request.resource.data.studentEmail)).data.studentId
        && request.resource.data.studentName == get(/databases/$(database)/documents/studentDirectory/$(request.resource.data.studentEmail)).data.name
        && validText(request.resource.data.title, 3, 120)
        && validText(request.resource.data.body, 20, 5000)
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.status == 'Draft - not official'
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if staff();
    }

    match /serviceRequests/{requestId} {
      allow read: if staff()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'studentName', 'studentId', 'email', 'phone',
          'serviceId', 'service', 'description', 'date', 'status',
          'fee', 'feeAmount', 'feeStatus', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && registeredStudent()
        && request.resource.data.studentId == get(/databases/$(database)/documents/studentDirectory/$(request.auth.token.email)).data.studentId
        && validName(request.resource.data.studentName, 20)
        && request.resource.data.studentId.matches('^90[0-9]{7}$')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+?[0-9]{8,15}$')
        && validText(request.resource.data.serviceId, 1, 40)
        && validText(request.resource.data['service'], 1, 100)
        && validText(request.resource.data.description, 10, 1500)
        && request.resource.data.fee is string
        && request.resource.data.fee.size() <= 40
        && request.resource.data.feeAmount is number
        && request.resource.data.feeAmount >= 0
        && request.resource.data.feeStatus in ['Unpaid', 'No fee']
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (staff()
          && request.resource.data.status in [
            'Pending', 'Accepted', 'In Progress', 'Completed', 'Rejected', 'Cancelled'
          ]
          && (!request.resource.data.keys().hasAny(['feeStatus'])
            || request.resource.data.feeStatus in ['Unpaid', 'Paid', 'No fee'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'feeStatus', 'updatedAt']))
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.status == resource.data.status
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['description', 'updatedAt'])
          && validText(request.resource.data.description, 10, 1500))
        || (signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'Pending'
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']));

      allow delete: if staff()
        || (signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'Pending');
    }

    match /publicInquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'serviceId', 'service', 'message',
          'status', 'createdAt'
        ])
        && validName(request.resource.data.name, 20)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+?[0-9]{8,15}$')
        && validText(request.resource.data.serviceId, 1, 40)
        && validText(request.resource.data['service'], 1, 100)
        && validText(request.resource.data.message, 10, 1500)
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time;

      allow read, delete: if staff();
      allow update: if staff()
        && request.resource.data.status in ['New', 'In Progress', 'Resolved']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if staff()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'department', 'processingTime', 'fee',
          'studentOnly', 'active', 'createdAt', 'updatedAt'
        ])
        && validText(request.resource.data.name, 1, 100)
        && validText(request.resource.data.description, 10, 500)
        && validText(request.resource.data.department, 1, 100)
        && validText(request.resource.data.processingTime, 1, 60)
        && validText(request.resource.data.fee, 1, 40)
        && request.resource.data.studentOnly is bool
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if staff()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'department', 'processingTime', 'fee',
          'studentOnly', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'department', 'processingTime', 'fee',
          'studentOnly', 'active', 'updatedAt'
        ])
        && validText(request.resource.data.name, 1, 100)
        && validText(request.resource.data.description, 10, 500)
        && validText(request.resource.data.department, 1, 100)
        && validText(request.resource.data.processingTime, 1, 60)
        && validText(request.resource.data.fee, 1, 40)
        && request.resource.data.studentOnly is bool
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if staff();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.read == false
        && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
