{
  "functions": {
    "source": "src/backend/functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "src/backend/firestore.rules"
  },
  "hosting": {
    "public": "src/frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
